<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="lumi · 快捷调节" Width="310" Height="146" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Background="{DynamicResource WindowTint}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12"><Border Background="{DynamicResource WindowTint}" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0" Padding="10,0"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions><Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource Selected}"><Image x:Name="Logo" Width="20" Height="20" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="lumi 标志"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="lumi" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"/></StackPanel><Button x:Name="OpenMain" Grid.Column="2" Style="{StaticResource Caption}" Width="30" Height="30" ToolTip="打开完整面板" AutomationProperties.Name="打开完整面板"><Path Data="M1,9 L9,1 M2,1 L9,1 9,8" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="10" Height="10"/></Button><Button x:Name="Dismiss" Grid.Column="3" Style="{StaticResource Caption}" Width="32" Height="32" ToolTip="收起面板" AutomationProperties.Name="收起面板"><Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10"/></Button></Grid>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid><TextBlock Text="未检测到屏幕，请打开完整面板重新检测" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="4,12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Screens.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
<ItemsControl ItemsSource="{Binding Screens}" IsEnabled="{Binding Ready}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,6"><Grid><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="38"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Brightness,StringFormat={}{0}%}" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Top"/></Grid>
<Grid Grid.Row="1" IsEnabled="{Binding CanBrightness}"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><Button Tag="BrightnessDown" Content="−" Style="{StaticResource Step}" Width="28" AutomationProperties.Name="降低亮度"/><Slider Grid.Column="1" Margin="8,0" Value="{Binding Brightness,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name}"/><Button Grid.Column="2" Tag="BrightnessUp" Content="+" Style="{StaticResource Step}" Width="28" AutomationProperties.Name="提高亮度"/></Grid></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></ScrollViewer>
<TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0" FontSize="12" ToolTip="{Binding Status}"/>
</Grid></Border></Window>